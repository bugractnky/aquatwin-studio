# Use matching URL-safe password values below. Do not commit backend/.env.
POSTGRES_PASSWORD=replace-with-local-db-password
DATABASE_URL=postgresql://aquatwin:replace-with-local-db-password@127.0.0.1:54329/aquatwin
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
AQUATWIN_INGEST_TOKEN=replace-with-your-local-token
# Separate local operator login; never use the device ingest token here.
# Set to a unique value of at least 16 characters to enable browser planning.
AQUATWIN_OPERATOR_PASSWORD=
AQUATWIN_OPERATOR_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5176,http://localhost:5173,http://localhost:5176
# true requires HTTPS; false/unset is for the documented localhost setup only.
AQUATWIN_SECURE_COOKIES=false
